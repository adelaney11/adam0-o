---
// Calm terminal / notepad surface: a faint, still graph-paper grid + soft
// vignette. No animation, no static — a quiet page you can annotate on.
---

<div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
  <div class="bd-grid absolute inset-0"></div>
  <div class="bd-vignette absolute inset-0"></div>
</div>

<style>
  .bd-grid {
    background-image:
      linear-gradient(rgba(159, 191, 143, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(159, 191, 143, 0.032) 1px, transparent 1px);
    background-size: 32px 32px;
    /* soften the grid toward the edges so it never feels busy */
    -webkit-mask-image: radial-gradient(135% 130% at 50% 35%, #000 50%, transparent 100%);
    mask-image: radial-gradient(135% 130% at 50% 35%, #000 50%, transparent 100%);
  }
  .bd-vignette {
    background: radial-gradient(125% 125% at 50% 40%, transparent 62%, rgba(0, 0, 0, 0.5) 100%);
  }
</style>
