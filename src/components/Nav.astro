---
import AsciiFace from './AsciiFace.astro';

const links = [
  { href: '#experience', label: 'experience' },
  { href: '#work', label: 'projects' },
  { href: '#about', label: 'about' },
  { href: '#contact', label: 'contact' },
];
---

<header class="fixed inset-x-0 top-0 z-30 transition-all duration-300" data-nav>
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4 font-mono">
    <!-- logo: desktop scrolls to top; mobile toggles the menu -->
    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      class="flex items-center gap-2.5 text-text"
    >
      <AsciiFace class="text-lg" />
      <span class="text-sm tracking-tight">adam_delaney</span>
      <span id="nav-chev" class="text-xs text-dim transition-transform duration-200 sm:hidden">▾</span>
    </button>

    <div class="flex items-center gap-1 text-xs sm:gap-3">
      <ul class="mr-2 hidden items-center gap-4 sm:flex">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="text-dim transition-colors duration-200 hover:text-phosphor">
                [{l.label}]
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/resume.pdf"
        target="_blank"
        class="bevel px-3 py-1.5 uppercase tracking-wider text-text transition-colors duration-200 hover:border-phosphor hover:text-phosphor"
      >
        résumé
      </a>
    </div>
  </nav>

  <!-- mobile dropdown menu -->
  <div id="nav-menu" class="hidden border-b border-line bg-bg/95 backdrop-blur-md sm:hidden">
    <ul class="mx-auto flex max-w-5xl flex-col px-6 pb-3 font-mono text-sm">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block border-t border-line/60 py-3 text-dim transition-colors hover:text-phosphor"
            >
              [{l.label}]
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const nav = document.querySelector('[data-nav]');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const chev = document.getElementById('nav-chev');

  // frosted background once you scroll past the hero
  const onScroll = () => {
    if (window.scrollY > 40) {
      nav?.classList.add('bg-bg/80', 'backdrop-blur-sm', 'border-b', 'border-line');
    } else if (menu?.classList.contains('hidden')) {
      nav?.classList.remove('bg-bg/80', 'backdrop-blur-sm', 'border-b', 'border-line');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const isDesktop = () => window.matchMedia('(min-width: 640px)').matches;
  const closeMenu = () => {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    if (chev) chev.style.transform = '';
    onScroll();
  };
  const openMenu = () => {
    menu?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    if (chev) chev.style.transform = 'rotate(180deg)';
    nav?.classList.add('bg-bg/80', 'backdrop-blur-sm', 'border-b', 'border-line');
  };

  toggle?.addEventListener('click', () => {
    if (isDesktop()) {
      document.getElementById('top')?.scrollIntoView({ behavior: 'smooth' });
      return;
    }
    if (menu?.classList.contains('hidden')) openMenu();
    else closeMenu();
  });

  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('click', (e) => {
    if (menu?.classList.contains('hidden')) return;
    if (!(e.target as HTMLElement).closest('[data-nav]')) closeMenu();
  });
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
  window.addEventListener('resize', () => { if (isDesktop()) closeMenu(); });
</script>
