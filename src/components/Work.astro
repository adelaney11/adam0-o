---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="work" class="relative z-10 px-6 py-4">
  <div class="mx-auto w-full max-w-5xl">
    <details open class="section-fold is-open">
      <SectionHeading index="[ 02 // projects ]" title="projects" />
      <div class="section-body">
        <div class="pt-10 pb-16">
          <ul class="flex flex-col">
            {
              projects.map((p, i) => {
                const href = p.data.link ?? p.data.repo;
                const Tag = href ? 'a' : 'div';
                return (
                  <li class="border-b border-line" data-reveal style={`transition-delay:${i * 60}ms`}>
                    <Tag
                      {...(href ? { href, target: '_blank', rel: 'noopener' } : {})}
                      class="group grid grid-cols-[auto_1fr_auto] items-start gap-x-5 gap-y-2 py-7"
                    >
                      <span class="pt-2 font-mono text-xs text-dim tabular-nums">0{i + 1}</span>

                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-x-3">
                          <h3 class="font-display text-4xl tracking-wide text-text transition-colors duration-200 group-hover:text-phosphor sm:text-5xl">
                            {p.data.title}
                          </h3>
                        </div>
                        <p class="mt-2 max-w-2xl font-mono text-sm leading-relaxed text-dim">
                          {p.data.summary}
                        </p>
                        <div class="mt-3 flex flex-wrap gap-2">
                          {p.data.tags.map((t) => (
                            <span class="border border-line px-2 py-0.5 font-mono text-[0.7rem] text-dim">
                              {t}
                            </span>
                          ))}
                        </div>
                      </div>

                      <div class="flex flex-col items-end gap-2 pt-2">
                        <span class="font-mono text-xs text-dim tabular-nums">{p.data.year}</span>
                        {href && (
                          <span class="text-dim transition-all duration-200 group-hover:translate-x-1 group-hover:text-phosphor">
                            ↗
                          </span>
                        )}
                      </div>
                    </Tag>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </details>
  </div>
</section>
