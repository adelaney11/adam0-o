---
import SectionHeading from './SectionHeading.astro';

const skills = [
  'Swift', 'SwiftUI', 'UIKit', 'Swift Concurrency', 'Combine', 'AVFoundation',
  'MVVM', 'XCTest', 'Instruments', 'URLSession', 'Swift Package Manager', 'Git',
  'Python', 'Flask / FastAPI', 'JavaScript', 'React', 'GraphQL', 'Firebase',
  'GCP', 'Convex',
];
---

<section id="about" class="relative z-10 px-6 py-4">
  <div class="mx-auto w-full max-w-5xl">
    <details open class="section-fold is-open">
      <SectionHeading index="[ 03 // about ]" title="about" />
      <div class="section-body">
        <div class="grid gap-12 pt-10 pb-16 md:grid-cols-[1.35fr_1fr]">
          <div class="space-y-5 font-mono text-sm leading-relaxed text-dim" data-reveal>
            <p>
              <span class="text-text">I'm Adam — an iOS engineer with 5+ years</span>
              shipping native apps across fintech, edtech, healthcare, and consumer
              products. I like owning the whole thing: architecture, UI, animation,
              and the unglamorous plumbing that keeps it fast.
            </p>
            <p>
              I care about the details others skip — the spring of an animation, the
              weight of a haptic, the frame you didn't notice drop. Lately I've been
              going full-stack on <a
                href="https://deskpop.online"
                target="_blank"
                rel="noopener"
                class="text-text underline decoration-dotted underline-offset-4 transition-colors hover:text-phosphor"
                >deskpop</a> and messing with hand-drawn animation (see: the boiling
              ink on this page).
            </p>
            <p class="font-mono text-xs text-dim/80">
              <span class="text-phosphor">status:</span> open to new roles ·
              always building something on the side.
            </p>

            <div class="bevel mt-6 p-4">
              <p class="font-mono text-xs uppercase tracking-wider text-phosphor">education</p>
              <p class="mt-2 text-sm text-text">Loyola University Chicago</p>
              <p class="text-sm text-dim">B.S. Software Engineering · May 2020</p>
              <p class="mt-1 text-xs text-dim">
                Turing High Achievement Award — top graduating S.E. student (1 of 4).
              </p>
            </div>
          </div>

          <div data-reveal style="transition-delay: 120ms">
            <h3 class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-dim">
              &gt; skills.txt
            </h3>
            <ul class="flex flex-wrap gap-2">
              {
                skills.map((t) => (
                  <li class="border border-line px-2.5 py-1 font-mono text-xs text-text/90 transition-colors duration-200 hover:border-phosphor hover:text-phosphor">
                    {t}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </details>
  </div>
</section>
